  "text.autoconfig.corgimod.title": "The Corgi Mod",
  "text.autoconfig.corgimod.option.general": "General",
  "text.autoconfig.corgimod.option.general.namingMode": "Naming Mode",
  "text.autoconfig.corgimod.option.general.namingMode.@Tooltip[0]": "Random Names: Applies a random name to the corgi unless the corgi already has a name. Corgis can be renamed.",
  "text.autoconfig.corgimod.option.general.namingMode.@Tooltip[1]": "Default Names: Displays \"Corgi\" prefixed by type. (Example: \"Pirate Corgi\"). NOTE: This disables naming of the corgis.",
  "text.autoconfig.corgimod.option.general.namingMode.@Tooltip[2]": "Off: Disables the auto-naming completely. Corgis can still be named. Vanilla behavior.",
  "text.autoconfig.corgimod.option.general.enableWorkInProgressFeatures": "Enable WIP Features",
  "text.autoconfig.corgimod.option.general.enableWorkInProgressFeatures.@Tooltip": "Enables features that may not be finished yet. Can cause weird behavior and even crashes. Backups are recommended.",
  "text.autoconfig.corgimod.option.general.corgiParticleEffects": "Corgi Particle Effects",
  "text.autoconfig.corgimod.option.general.corgiParticleEffects.@Tooltip": "Enables the particle effects around the corgis. Turn this off if you're suffering from frame rate issues.",
  "text.autoconfig.corgimod.option.general.breedingMode": "Breeding Mode",
  "text.autoconfig.corgimod.option.general.breedingMode.@Tooltip[0]": "Parents: Breeding two corgis together spawns a child based on one of the parents.",
  "text.autoconfig.corgimod.option.general.breedingMode.@Tooltip[1]": "Random: Breeding two corgis together spawns a completely random child corgi.",
  "text.autoconfig.corgimod.option.general.allowUraniumTNTBoosting": "Uranium TNT Boosting",
  "text.autoconfig.corgimod.option.general.allowUraniumTNTBoosting.@Tooltip": "Blowing up TNT next to a uranium ingot boosts the explosion.",
  "text.autoconfig.corgimod.option.general.passiveCorgiSpawnWeight": "Passive Corgi Spawn Weight",
  "text.autoconfig.corgimod.option.general.passiveCorgiSpawnWeight.@Tooltip": "The weight of the passive corgi spawns. Default: 5. NOTE: The weight is applied per corgi as they are all separate entities.",
  "text.autoconfig.corgimod.option.general.creeperCorgiSpawnWeight": "Creeper Corgi Spawn Weight",
  "text.autoconfig.corgimod.option.general.creeperCorgiSpawnWeight.@Tooltip": "The weight of the creeper corgi spawns. Default: 35 (Normal creepers have a weight of 100)",
  "text.autoconfig.corgimod.option.general.enderCorgiSpawnWeight": "Ender Corgi Spawn Weight",
  "text.autoconfig.corgimod.option.general.enderCorgiSpawnWeight.@Tooltip": "The weight of the ender corgi spawns. Default: 8 (Normal enderman have a weight of 10)",
  "text.autoconfig.corgimod.option.general.skeletonCorgiSpawnWeight": "Skeleton Corgi Spawn Weight",
  "text.autoconfig.corgimod.option.general.skeletonCorgiSpawnWeight.@Tooltip": "The weight of the skeleton corgi spawns. Default: 25 (Normal skeletons have a weight of 80)",
  "text.autoconfig.corgimod.option.general.zombieCorgiSpawnWeight": "Zombie Corgi Spawn Weight",
  "text.autoconfig.corgimod.option.general.zombieCorgiSpawnWeight.@Tooltip": "The weight of the zombie corgi spawns. Default: 35 (Normal zombies have a weight of 100)",
