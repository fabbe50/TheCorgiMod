  "text.thecorgimod.title": "The Corgi Mod",
  "text.thecorgimod.option.general": "General",
  "text.thecorgimod.option.general.namingMode": "Naming Mode",
  "text.thecorgimod.option.general.namingMode.@Tooltip[0]": "Random Names: Applies a random name to the corgi unless the corgi already has a name. Corgis can be renamed.",
  "text.thecorgimod.option.general.namingMode.@Tooltip[1]": "Default Names: Displays \"Corgi\" prefixed by type. (Example: \"Pirate Corgi\"). NOTE: This disables naming of the corgis.",
  "text.thecorgimod.option.general.namingMode.@Tooltip[2]": "Off: Disables the auto-naming completely. Corgis can still be named. Vanilla behavior.",
  "text.thecorgimod.option.general.enableWorkInProgressFeatures": "Enable WIP Features",
  "text.thecorgimod.option.general.enableWorkInProgressFeatures.@Tooltip": "Enables features that may not be finished yet. Can cause weird behavior and even crashes. Backups are recommended.",
  "text.thecorgimod.option.general.corgiParticleEffects": "Corgi Particle Effects",
  "text.thecorgimod.option.general.corgiParticleEffects.@Tooltip": "Enables the particle effects around the corgis. Turn this off if you're suffering from frame rate issues.",
  "text.thecorgimod.option.general.breedingMode": "Breeding Mode",
  "text.thecorgimod.option.general.breedingMode.@Tooltip[0]": "Parents: Breeding two corgis together spawns a child based on one of the parents.",
  "text.thecorgimod.option.general.breedingMode.@Tooltip[1]": "Random: Breeding two corgis together spawns a completely random child corgi.",
  "text.thecorgimod.option.corgiAbilities": "Corgi Abilities",
  "text.thecorgimod.option.corgiAbilities.loveCorgiEffectRange": "Love Corgi Effect Range",
  "text.thecorgimod.option.corgiAbilities.loveCorgiEffectRange.@Tooltip": "Set the maximum radius the love corgi checks for when activating breeding for them",
  "text.thecorgimod.option.corgiAbilities.loveCorgiMaxEntityCount": "Love Corgi Max Entity Count",
  "text.thecorgimod.option.corgiAbilities.loveCorgiMaxEntityCount.@Tooltip": "Set the maximum amount of entities that are allowed around the love corgi for the ability to deactivate.",
  "text.thecorgimod.option.corgiAbilities.pirateCorgiBoatSpeed": "Pirate Corgi Boat Speed Multiplier",
  "text.thecorgimod.option.corgiAbilities.pirateCorgiBoatSpeed.@Tooltip": "Set the multiplier for how many times faster the boat will go when the pirate corgi is riding with you in the boat.",
  "text.thecorgimod.option.corgiAbilities.spyCorgiRange": "Spy Corgi Reveal Range",
  "text.thecorgimod.option.corgiAbilities.spyCorgiRange.@Tooltip": "Set the maximum radius the spy corgi will apply the glow effect to mobs around it.",
